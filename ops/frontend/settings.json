{
  "service": "jax-platform-frontend.service",
  "user": "jaxsvc",
  "group": "jaxsvc",
  "release_root": "/srv/jax-platform-frontend",
  "nginx_root": "/etc/jax/frontend-nginx",
  "dropin_name": "zz-nginx-estatico.conf",
  "runtime_directory": "jax-platform-frontend-nginx",
  "node_version": "24.16.0",
  "npm_version": "11.13.0",
  "vite_version": "6.4.3",
  "nginx_version": "1.28.3",
  "listen_host": "0.0.0.0",
  "listen_port": 5173,
  "worker_connections": 128,
  "nginx_binary": "/usr/sbin/nginx",
  "worker_processes": 1,
  "websocket_read_timeout_seconds": 3600
}
