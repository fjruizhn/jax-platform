[Unit]
Description=Axioma Virtual Office invitation delivery (one bounded batch)
After=network-online.target jax-platform-migrate.service
Wants=network-online.target
ConditionPathIsReadWrite=/run
OnFailure=aviso-fallo@%n.service

[Service]
Type=oneshot
User=jaxinvite
Group=jaxinvite
EnvironmentFile=/etc/jax/invitation-worker.env
WorkingDirectory=/srv/jax-prod/jax-platform/backend
# EnvironmentFile is root-only.  The preflight merely validates inherited
# settings and its ownership before the unprivileged process starts.
ExecStartPre=+/srv/jax-prod/jax-platform/ops/virtualoffice/invitation-worker-readiness.sh
ExecStart=/srv/jax-prod/jax-platform/backend/.venv/bin/python -Es /srv/jax-prod/jax-platform/ops/virtualoffice/run-invitation-worker.py
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
LimitCORE=0
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077
# Maximum configured batch is 1,000 and SMTP's verified per-attempt timeout is
# 10 seconds; leave margin for bounded DB settlement and finalization.
TimeoutStartSec=3h
KillMode=control-group

