[Unit]
Description=Virtual Office schema migration
Requires=docker.service
After=network-online.target docker.service
Wants=network-online.target
Before=axioma-office-backend.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=officemigrate
WorkingDirectory=/
LoadCredential=migrate.env:/etc/axioma-office/migrate.env
ExecStart=/usr/bin/python3 -I -S /usr/local/libexec/jax-platform-pair-exec.py office-migrate ${CREDENTIALS_DIRECTORY}/migrate.env
