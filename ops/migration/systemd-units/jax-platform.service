[Unit]
StartLimitIntervalSec=300
StartLimitBurst=5
Description=JAX Platform Backend
After=network.target docker.service jax-las-manos.service jax-platform-migrate.service
Requires=jax-platform-migrate.service
Wants=docker.service jax-las-manos.service

[Service]
Type=simple
User=jaxweb
WorkingDirectory=/
LoadCredential=runtime.env:/etc/jax/runtime.env
ExecStart=/usr/bin/python3 -I -S /usr/local/libexec/jax-platform-pair-exec.py web ${CREDENTIALS_DIRECTORY}/runtime.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
