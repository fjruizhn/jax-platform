[Unit]
StartLimitIntervalSec=300
StartLimitBurst=5
Description=JAX Platform Backend
After=network.target docker.service jax-las-manos.service jax-platform-migrate.service
Requires=jax-platform-migrate.service
Wants=docker.service jax-las-manos.service

[Service]
Environment="PATH=/home/fruiz/.nvm/versions/node/v24.16.0/bin:/home/fruiz/.local/bin:/usr/local/bin:/usr/bin:/bin"
Type=simple
User=jaxweb
WorkingDirectory=/
# Runtime receives only the filtered web configuration and DML credential.
EnvironmentFile=/etc/jax/runtime.env
ExecStart=/usr/local/libexec/jax-platform-pair-exec web
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
