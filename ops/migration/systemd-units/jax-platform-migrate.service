[Unit]
Description=JAX Platform schema migration (one-shot)
Requires=docker.service
After=network-online.target docker.service
Wants=network-online.target docker.service
Before=jax-platform.service

[Service]
Type=oneshot
# The oneshot receives only its minimal migration credential and runner paths.
User=jaxmigrate
WorkingDirectory=/opt/jax-platform-pair/current/jax-platform/backend
Environment=JAX_REPO_PATH=/opt/jax-platform-pair/current/jax
EnvironmentFile=/etc/jax/migrate.env
ExecStartPre=/usr/local/libexec/jax-platform-pair-artifact-readiness
ExecStart=/opt/jax-platform-pair/current/jax-platform/backend/.venv/bin/python -m db.migrate
