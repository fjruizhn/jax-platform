[Unit]
Description=JAX Platform schema migration (one-shot)
Requires=docker.service
After=network-online.target docker.service
Wants=network-online.target docker.service
Before=jax-platform.service

[Service]
Type=oneshot
# The oneshot receives only its minimal migration credential and runner paths.
User=jaxmigrate
WorkingDirectory=/
EnvironmentFile=/etc/jax/migrate.env
UnsetEnvironment=BASH_ENV LD_PRELOAD LD_LIBRARY_PATH PYTHONPATH PYTHONHOME VIRTUAL_ENV JAX_REPO_PATH
ExecStart=/usr/local/libexec/jax-platform-pair-exec migrate
