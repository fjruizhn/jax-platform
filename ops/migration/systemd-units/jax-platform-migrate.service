[Unit]
Description=JAX Platform schema migration (one-shot)
Requires=docker.service
After=network-online.target docker.service
Wants=network-online.target docker.service
Before=jax-platform.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=jaxmigrate
WorkingDirectory=/
LoadCredential=migrate.env:/etc/jax/migrate.env
ExecStart=/usr/bin/python3 -I -S /usr/local/libexec/jax-platform-pair-exec.py migrate ${CREDENTIALS_DIRECTORY}/migrate.env
