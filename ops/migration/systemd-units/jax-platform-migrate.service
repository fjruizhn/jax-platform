[Unit]
Description=JAX Platform schema migration (one-shot)
After=network.target mariadb.service
Before=jax-platform.service

[Service]
Type=oneshot
# The oneshot receives only its minimal migration credential and runner paths.
User=jaxmigrate
WorkingDirectory=/srv/jax-prod/jax-platform/backend
EnvironmentFile=/etc/jax/migrate.env
ExecStart=/srv/jax-prod/jax-platform/backend/.venv/bin/python -m db.migrate
