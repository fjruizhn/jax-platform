[Unit]
Description=JAX Platform — sync programado del catálogo de modelos (Bloque D)
# A-7 (auditoría adversarial, 2026-09-27): la MariaDB real corre en Docker
# (`mariadb-12-3-jax`, ver CLAUDE.md/CONTEXT.md), no como `mariadb.service`
# de systemd -- esperar por esa unidad no esperaba nada de verdad. Se espera
# a que la red esté arriba y a que el DAEMON de Docker haya arrancado (no a
# que el contenedor específico esté sano: eso lo decide `catalogo_modelos_ejecutor`
# en tiempo de ejecución, con su propio timeout de conexión a la DB).
After=network-online.target docker.service
Wants=network-online.target
# Sin OnFailure=: `catalogo_modelos_ejecutor.py::main()` YA manda su propio
# aviso por Telegram tanto si `sync_all()` termina con `ok=False` como si
# revienta de una manera inesperada (DB caída, import roto -- ver A-2), y en
# los dos casos sale con código != 0. Una unidad OnFailure= aparte sumaría
# un SEGUNDO camino de aviso (probablemente por email, systemd no manda
# Telegram) que puede decir algo distinto del primero y quedar sin
# mantenimiento -- un solo lugar que decide "hay que avisar" es más fácil de
# confiar que dos que puedan divergir (Regla Absoluta).

[Service]
Type=oneshot
User=jaxsvc
Group=jaxsvc
WorkingDirectory=/srv/jax-prod/jax-platform/backend
EnvironmentFile=/etc/jax/.env
ExecStart=/srv/jax-prod/jax-platform/backend/.venv/bin/python -m catalogo_modelos_ejecutor
# Acotado: 7 proveedores x 15s de timeout HTTP en el peor caso + el
# enriquecimiento (otros 15s) + el aviso de Telegram (10s) caben de sobra en
# 5 minutos; si el job se cuelga más que eso, mejor que systemd lo mate y
# quede en rojo a que un proveedor caído deje el timer trabado hasta la
# próxima corrida de las 6h.
TimeoutStartSec=5min
StandardOutput=journal
StandardError=journal
